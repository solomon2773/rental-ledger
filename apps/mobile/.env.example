# URL of the API server as reachable from the device running the app.
#  - Web / iOS simulator:  http://localhost:8787
#  - Android emulator:     http://10.0.2.2:8787
#  - Physical phone:       http://<your-computer-LAN-IP>:8787  (same Wi-Fi)
# If unset, the app guesses using the Metro dev-server host.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Production (web build is done by deploy/Dockerfile.web with this value baked in):
# EXPO_PUBLIC_API_URL=https://rental-ledger.solomontsao.com/api
