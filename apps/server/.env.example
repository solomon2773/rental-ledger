# ---- Server ----
PORT=8787
# Public base URL of this server (used to build the Google OAuth redirect URI).
SERVER_PUBLIC_URL=http://localhost:8787
# Random string, at least 32 chars. Signs session tokens and encrypts stored Google refresh tokens.
#   openssl rand -base64 48
APP_SECRET=change-me-change-me-change-me-change-me
# Where SQLite + uploaded receipt images live (relative to apps/server).
DATA_DIR=./data

# ---- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client, type "Web application") ----
# Authorised redirect URI must be: ${SERVER_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated prefixes the app is allowed to be redirected back to after login.
ALLOWED_APP_REDIRECTS=rentalledger://,http://localhost:8081,exp://
# Name of the top-level folder created in the user's Drive.
DRIVE_ROOT_FOLDER_NAME=Rental Ledger

# ---- Anthropic (receipt recognition) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (medium is the model default; low is faster/cheaper and fine for clean receipts)
ANTHROPIC_EFFORT=medium
