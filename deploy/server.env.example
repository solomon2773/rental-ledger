# API server environment (deploy/server.env) - production values for rental-ledger.solomontsao.com

# Public URL of the API *as seen by browsers*. Caddy maps /api -> server, so include /api.
# The Google OAuth redirect URI becomes ${SERVER_PUBLIC_URL}/auth/google/callback :
#   https://rental-ledger.solomontsao.com/api/auth/google/callback   <- add this to the OAuth client
SERVER_PUBLIC_URL=https://rental-ledger.solomontsao.com/api

# Random secret, >= 32 chars:  openssl rand -base64 48
APP_SECRET=

# Google Cloud -> APIs & Services -> Credentials -> OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the login flow may send users back to: the web app origin, the native app scheme, Expo Go.
ALLOWED_APP_REDIRECTS=https://rental-ledger.solomontsao.com,rentalledger://,exp://

DRIVE_ROOT_FOLDER_NAME=Rental Ledger

# Anthropic (receipt recognition)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
