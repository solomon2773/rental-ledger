# syntax=docker/dockerfile:1
# Web image: builds the Expo web app with the API URL baked in, then serves it with Caddy
# (automatic HTTPS) and proxies /api/* to the server container.
FROM node:22-bookworm-slim AS build
ARG EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL} CI=1 EXPO_NO_TELEMETRY=1
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY packages/shared/package.json packages/shared/
COPY apps/mobile/package.json apps/mobile/
RUN npm ci -w packages/shared -w apps/mobile --include-workspace-root --no-audit --no-fund
COPY packages/shared packages/shared
COPY apps/mobile apps/mobile
RUN npm run build -w packages/shared \
 && cd apps/mobile \
 && npx expo export --platform web --output-dir /out

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /out /srv/web
