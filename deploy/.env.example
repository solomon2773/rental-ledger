# Compose variables (deploy/.env)
# Public hostname. DNS A record must point at this host (rental-ledger.solomontsao.com -> 75.10.217.13).
SITE_DOMAIN=rental-ledger.solomontsao.com
# Leave empty to let Caddy serve HTTPS for SITE_DOMAIN itself.
# Set to ":8080" when using compose.behind-proxy.yml.
SITE_ADDRESS=
